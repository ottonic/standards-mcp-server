{
  "name": "standards-mcp-server",
  "version": "0.2.1",
  "description": "Reference standards for mechanical engineering: ISO 286 limits and fits, ISO 2768 general tolerances, typical material properties, and published process feasibility limits.",
  "author": "Matt Mohandiss <mattmohandiss@gmail.com>",
  "license": "MIT",
  "mcpName": "io.github.ottonic/standards-mcp-server",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ottonic/standards-mcp-server.git"
  },
  "homepage": "https://github.com/ottonic/standards-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ottonic/standards-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iso-286",
    "iso-2768",
    "tolerances",
    "limits-and-fits",
    "materials",
    "dfm",
    "mechanical-engineering",
    "standards",
    "ai-tools"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "bin": {
    "standards-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/package.json",
    "!dist/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "server.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "fmt": "prettier --write src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts",
    "fmt:check": "prettier --check src tests package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
